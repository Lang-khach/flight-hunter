# Token Duffel: https://app.duffel.com -> Developers -> Access tokens
# duffel_test_... = môi trường test (vé ảo, không mất tiền)
# duffel_live_... = vé thật, trừ tiền vào balance Duffel
DUFFEL_TOKEN=duffel_test_xxxxxxxxxxxxxxxx

# Thông báo Telegram – nên cấu hình trên web (menu Telegram). Điền ở đây chỉ là dự phòng
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Công tắc an toàn: phải = true thì tool mới được TỰ ĐẶT VÉ (kể cả khi hunt có autoBook: true)
ALLOW_AUTOBOOK=false

# ===== Giao diện web quản trị =====
PORT=8080
# 127.0.0.1 = chỉ truy cập trên máy này. 0.0.0.0 = cho phép truy cập từ máy khác/điện thoại
# (khi mở ra ngoài nên đặt sau Nginx/Caddy có HTTPS)
HOST=127.0.0.1
# Tài khoản quản trị tạo ở LẦN CHẠY ĐẦU (sau đó có thể xoá 2 dòng này, đổi mật khẩu trên web)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Phiên đăng nhập hết hạn sau bao nhiêu giờ không hoạt động
SESSION_TTL_HOURS=12
# true khi chạy sau HTTPS (cookie chỉ gửi qua HTTPS)
COOKIE_SECURE=false
# true khi chạy sau reverse proxy để lấy đúng IP người dùng (chống dò mật khẩu)
TRUST_PROXY=false
